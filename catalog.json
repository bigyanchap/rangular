  "diagnostics": [
    {
      "code": "TPL_INTERPOLATION",
      "meaning": "A {{ interpolation in a template is never closed with }}."
    },
    {
      "code": "TPL_TAG",
      "meaning": "A \"<\" in a template is not followed by a tag name."
    },
    {
      "code": "TPL_UNCLOSED",
      "meaning": "An element is opened but never closed."
    },
    {
      "code": "TPL_ATTR",
      "meaning": "An attribute in a template could not be parsed."
    },
    {
      "code": "TPL_CLOSE",
      "meaning": "A closing tag appears with no matching opening element."
    },
    {
      "code": "TPL_MISMATCH",
      "meaning": "A closing tag does not match the currently open element."
    },
    {
      "code": "TPL_NGFOR",
      "meaning": "The *ngFor microsyntax could not be parsed."
    },
    {
      "code": "TPL_NGFOR_SEGMENT",
      "meaning": "A segment of *ngFor microsyntax is not supported and was ignored."
    },
    {
      "code": "CLS_NO_COMPONENT",
      "meaning": "No class decorated with @Component was found in the source file."
    },
    {
      "code": "CMP_TEMPLATE",
      "meaning": "The component template could not be resolved (missing inline template and templateUrl)."
    },
    {
      "code": "CSS_SELECTOR",
      "meaning": "A CSS selector is not an element or .class selector; the rule was skipped."
    },
    {
      "code": "CSS_DECL",
      "meaning": "A CSS declaration is malformed (expected \"property: value\")."
    },
    {
      "code": "CSS_UNSUPPORTED",
      "meaning": "A CSS property is outside the supported subset; the declaration was dropped."
    },
    {
      "code": "STYLE_OFF_SCALE",
      "meaning": "A spacing, radius or font-size value is off its design-token scale; the generated style uses the nearest on-scale value."
    },
    {
      "code": "GEN_UNKNOWN_TAG",
      "meaning": "A template tag is not a known Rangular block; it was emitted as <View>."
    },
    {
      "code": "GEN_FIELD",
      "meaning": "A field has a non-literal initializer that cannot be emitted verbatim into the generated component (it references this, or the field is assigned in a method); it is declared as undefined there so the output still compiles. A never-assigned non-literal initializer without this (new Date(), Date.now(), an expression over literals) is emitted verbatim and does not warn."
    },
    {
      "code": "GEN_FIELD_STATE",
      "meaning": "A field is assigned in a method but has a non-literal initializer, so it cannot become useState yet."
    },
    {
      "code": "GEN_NGIF_ELSE_TODO",
      "meaning": "*ngIf with else/then microsyntax is not generated yet; the element was emitted unconditionally."
    },
    {
      "code": "GEN_STRUCTURAL_TODO",
      "meaning": "A structural directive other than *ngIf/*ngFor is not supported yet; the element was emitted unconditionally."
    },
    {
      "code": "GEN_CONTROL_NESTING",
      "meaning": "A declaration is nested in the wrong parent; option belongs in switcher, radio belongs in radio-group, tab belongs in tabs, and column belongs in table, and those groups (plus accordion, which takes panels only) accept only their own declarations."
    },
    {
      "code": "GEN_ICON_UNKNOWN",
      "meaning": "An <icon> names an icon that is not in the Rangular icon set; the JSON form of this diagnostic carries the full valid list in validIcons."
    },
    {
      "code": "GEN_ICON_NAME",
      "meaning": "An <icon> element has no name attribute and no [name] binding, so there is nothing to draw."
    },
    {
      "code": "GEN_ICON_SIZE",
      "meaning": "An <icon> size is off the icon size scale (20, 24, 28); the generated code uses the nearest on-scale size."
    },
    {
      "code": "GEN_NGMODEL_TARGET",
      "meaning": "ngModel (two-way, [ngModel] or (ngModelChange)) is used on an element other than <input>; in this version ngModel binds text inputs only."
    },
    {
      "code": "GEN_NGMODEL_EXPR",
      "meaning": "An ngModel binding does not target a plain component field with a literal initial value, so no write-back or validation state could be generated; the value is bound one way."
    },
    {
      "code": "GEN_FORM_CONTROL",
      "meaning": "A formControlName cannot be bound: the input is not inside a <form> with a [formGroup], the control name is not one of the group's controls, or formControlName was written as a [binding] instead of a static attribute."
    },
    {
      "code": "GEN_FORMGROUP_TYPE",
      "meaning": "A [formGroup] binding does not name a field initialised with new FormGroup(...), so the reactive form cannot be wired."
    },
    {
      "code": "GEN_FORM_INITIALIZER",
      "meaning": "A field initialised with new FormGroup(...) or new FormControl(...) uses a shape the preview cannot evaluate (only literal values, Validators references and validator calls are supported); the generated app runs the initializer as written."
    },
    {
      "code": "GEN_ROUTES_MISSING",
      "meaning": "A template uses <router-outlet> or routerLink, or a component injects Router or ActivatedRoute, but no routes file was resolved: the compiler looks for app.routes.ts next to the root component, or the file named by the CLI --routes flag."
    },
    {
      "code": "GEN_ROUTE_COMPONENT",
      "meaning": "A route entry names a component class that is not an @Component class resolved in this compilation."
    },
    {
      "code": "GEN_ROUTE_DUPLICATE",
      "meaning": "Two route entries declare the same path; matching tries entries in order, so the first one wins and the later one never renders."
    },
    {
      "code": "GEN_ROUTE_UNSUPPORTED",
      "meaning": "A route entry or routing construct uses an Angular routing feature Rangular does not support yet (child routes, guards, resolvers, lazy loading, nested outlets, routerLink on a component tag), or a route entry is not a plain object literal with a string path."
    },
    {
      "code": "GEN_PICKER_MODE",
      "meaning": "A <datetime-picker> mode is not one of the three picker modes (date, time, datetime)."
    },
    {
      "code": "GEN_PICKER_INTERVAL",
      "meaning": "A <datetime-picker> minuteInterval is not 1 or 5; the generated code uses the nearest of the two."
    },
    {
      "code": "GEN_OVERLAY_OPEN",
      "meaning": "A <sheet> or <dialog> has no [open] binding, so it cannot be opened or closed from the component; it renders statically open."
    },
    {
      "code": "GEN_EVENT_ASSIGNMENT",
      "meaning": "An event binding holds an assignment statement (for example (close)=\"sheetOpen = false\"); template event bindings take a method call, never an assignment, so the binding was dropped."
    },
    {
      "code": "GEN_TABLE_COLUMN",
      "meaning": "A <column> has no name attribute (or key alias) naming the row property it displays, so the table cannot read its cells."
    },
    {
      "code": "GEN_SLIDER_RANGE",
      "meaning": "A <slider> range is unusable: min must be below max (an error, checked when both are statically known), and step must be above zero (a warning; the generated code uses 1)."
    },
    {
      "code": "GEN_PROGRESS_RANGE",
      "meaning": "A <progress-bar> value is statically known to sit outside 0 to 100; the generated code clamps it into range."
    },
    {
      "code": "GEN_SPINNER_SIZE",
      "meaning": "A <spinner> size is off the icon size scale (20, 24, 28); the generated code uses the nearest on-scale size."
    },
    {
      "code": "GEN_BADGE_HOST",
      "meaning": "A badge attribute or [badge] binding sits on an element that cannot host a badge in this version (button, row and icon can); the badge was dropped."
    },
    {
      "code": "METHOD_UNSUPPORTED",
      "meaning": "A statement in a component method is outside the supported translation subset; it was left as a TODO."
    },
    {
      "code": "CMP_IMPORT_UNRESOLVED",
      "meaning": "A relative import in a compiled file could not be resolved to a source file."
    },
    {
      "code": "CMP_PATH_ESCAPE",
      "meaning": "A templateUrl, styleUrl or relative import resolved to a file outside the project root; the file was not read."
    },
    {
      "code": "CMP_IMPORT_CYCLE",
      "meaning": "Two or more source files import each other in a cycle; the cycle was broken at the repeated file, whose classes were already registered."
    },
    {
      "code": "CMP_DUP_SELECTOR",
      "meaning": "Two different component classes declare the same selector in one compilation."
    },
    {
      "code": "DI_UNKNOWN_TOKEN",
      "meaning": "A constructor dependency names a type that is not a known @Injectable({ providedIn: 'root' }) service in this compilation and not a built-in token (HttpClient, Router / ActivatedRoute in a routed app, or SnackBar in a component)."
    },
    {
      "code": "DI_CYCLE",
      "meaning": "Injectable services depend on each other in a cycle; container registrations could not be ordered."
    },
    {
      "code": "DOC_HEX_COLOR",
      "meaning": "Doctor: a hex colour literal appears in the component styles instead of a colour role token."
    },
    {
      "code": "DOC_OFF_SCALE",
      "meaning": "Doctor: a spacing, radius or font-size value in the styles is off its design-token scale (the compiler would snap it)."
    },
    {
      "code": "DOC_RAW_TEXT",
      "meaning": "Doctor: loose text sits directly inside a container element instead of a text element."
    },
    {
      "code": "DOC_TAP_TARGET",
      "meaning": "Doctor: an element with a (click) binding is sized below the 44 by 44 minimum tap target."
    },
    {
      "code": "DOC_IMG_SIZE",
      "meaning": "Doctor: an image element has no declared width and height."
    },
    {
      "code": "CLI_INIT_NOT_EMPTY",
      "meaning": "The rangular init command was pointed at a directory that is not empty."
    },
    {
      "code": "PIPE_UNKNOWN",
      "meaning": "A template uses a pipe that is neither a built-in pipe nor a @Pipe class resolved in this compilation; the JSON form lists the known pipes in the fix."
    },
    {
      "code": "GEN_VALIDATOR_ARG",
      "meaning": "A static minlength or maxlength attribute value is not a plain number; the validator was dropped instead of emitting the text into generated code."
    },
    {
      "code": "DIR_UNSUPPORTED",
      "meaning": "An attribute directive is outside the supported subset (a bracket selector, @Input fields, an ElementRef, and ngOnInit or setter bodies made only of this.el.nativeElement.style.<prop> assignments), or it is used on a host the subset cannot style; the directive applied no styles."
    },
    {
      "code": "PROJECTION_SELECT_UNSUPPORTED",
      "meaning": "An <ng-content> carries a select attribute; multi-slot projection is not supported yet, so the element behaves as the default slot and receives all projected children."
    },
    {
      "code": "CLI_INIT_UNSAFE",
      "meaning": "The rangular init target name is not a safe directory name (letters, digits, dot, underscore and hyphen only, and not . or ..); nothing was written."
    }
  ]
}
