  "diagnostics": [
    {
      "code": "TPL_INTERPOLATION",
      "meaning": "A {{ interpolation in a template is never closed with }}."
    },
    {
      "code": "TPL_TAG",
      "meaning": "A \"<\" in a template is not followed by a tag name."
    },
    {
      "code": "TPL_UNCLOSED",
      "meaning": "An element is opened but never closed."
    },
    {
      "code": "TPL_ATTR",
      "meaning": "An attribute in a template could not be parsed."
    },
    {
      "code": "TPL_CLOSE",
      "meaning": "A closing tag appears with no matching opening element."
    },
    {
      "code": "TPL_MISMATCH",
      "meaning": "A closing tag does not match the currently open element."
    },
    {
      "code": "TPL_NGFOR",
      "meaning": "The *ngFor microsyntax could not be parsed."
    },
    {
      "code": "TPL_NGFOR_SEGMENT",
      "meaning": "A segment of *ngFor microsyntax is not supported and was ignored."
    },
    {
      "code": "CLS_NO_COMPONENT",
      "meaning": "No class decorated with @Component was found in the source file."
    },
    {
      "code": "CMP_TEMPLATE",
      "meaning": "The component template could not be resolved (missing inline template and templateUrl)."
    },
    {
      "code": "CSS_SELECTOR",
      "meaning": "A CSS selector is not an element or .class selector; the rule was skipped."
    },
    {
      "code": "CSS_DECL",
      "meaning": "A CSS declaration is malformed (expected \"property: value\")."
    },
    {
      "code": "CSS_UNSUPPORTED",
      "meaning": "A CSS property is outside the supported subset; the declaration was dropped."
    },
    {
      "code": "STYLE_OFF_SCALE",
      "meaning": "A spacing, radius or font-size value is off its design-token scale; the generated style uses the nearest on-scale value."
    },
    {
      "code": "GEN_UNKNOWN_TAG",
      "meaning": "A template tag is not a known Rangular block; it was emitted as <View>."
    },
    {
      "code": "GEN_FIELD",
      "meaning": "A field has a non-literal initializer and was not hoisted into the generated component."
    },
    {
      "code": "GEN_FIELD_STATE",
      "meaning": "A field is assigned in a method but has a non-literal initializer, so it cannot become useState yet."
    },
    {
      "code": "GEN_NGIF_ELSE_TODO",
      "meaning": "*ngIf with else/then microsyntax is not generated yet; the element was emitted unconditionally."
    },
    {
      "code": "GEN_STRUCTURAL_TODO",
      "meaning": "A structural directive other than *ngIf/*ngFor is not supported yet; the element was emitted unconditionally."
    },
    {
      "code": "GEN_CONTROL_NESTING",
      "meaning": "A control declaration is nested in the wrong parent; option belongs in switcher and radio belongs in radio-group, and those groups accept only their own declarations."
    },
    {
      "code": "GEN_ICON_UNKNOWN",
      "meaning": "An <icon> names an icon that is not in the Rangular icon set; the JSON form of this diagnostic carries the full valid list in validIcons."
    },
    {
      "code": "GEN_ICON_NAME",
      "meaning": "An <icon> element has no name attribute and no [name] binding, so there is nothing to draw."
    },
    {
      "code": "GEN_ICON_SIZE",
      "meaning": "An <icon> size is off the icon size scale (20, 24, 28); the generated code uses the nearest on-scale size."
    },
    {
      "code": "METHOD_UNSUPPORTED",
      "meaning": "A statement in a component method is outside the supported translation subset; it was left as a TODO."
    },
    {
      "code": "CMP_IMPORT_UNRESOLVED",
      "meaning": "A relative import in a compiled file could not be resolved to a source file."
    },
    {
      "code": "CMP_PATH_ESCAPE",
      "meaning": "A templateUrl, styleUrl or relative import resolved to a file outside the project root; the file was not read."
    },
    {
      "code": "CMP_IMPORT_CYCLE",
      "meaning": "Two or more source files import each other in a cycle; the cycle was broken at the repeated file, whose classes were already registered."
    },
    {
      "code": "CMP_DUP_SELECTOR",
      "meaning": "Two different component classes declare the same selector in one compilation."
    },
    {
      "code": "DI_UNKNOWN_TOKEN",
      "meaning": "A constructor dependency names a type that is not a known @Injectable({ providedIn: 'root' }) service or HttpClient in this compilation."
    },
    {
      "code": "DI_CYCLE",
      "meaning": "Injectable services depend on each other in a cycle; container registrations could not be ordered."
    },
    {
      "code": "DOC_HEX_COLOR",
      "meaning": "Doctor: a hex colour literal appears in the component styles instead of a colour role token."
    },
    {
